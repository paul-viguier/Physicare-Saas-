# PHYSICARE® — Variables d'environnement
# Copier en .env.local et remplir.

# ── Supabase (obligatoire) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://qthhcykougfclamrzlfx.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=
# Service role (côté serveur uniquement — JAMAIS exposé au client)
SUPABASE_SERVICE_ROLE_KEY=

# ── Enrichissement contacts (Phase 1) ──────────────────
# Dropcontact (RGPD-friendly, FR) — prioritaire
DROPCONTACT_API_KEY=
# Apollo.io — secondaire
APOLLO_API_KEY=
# Hunter.io — vérification email
HUNTER_API_KEY=
# Pappers — données légales FR (SIREN, dirigeants)
PAPPERS_API_KEY=

# ── LinkedIn officiel (Phase 2) ────────────────────────
# Unipile — API partenaire officielle (compte utilisateur OAuth)
UNIPILE_API_KEY=
UNIPILE_DSN=

# ── Email ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=PHYSICARE® <prospection@physicare.fr>
POSTMARK_SERVER_TOKEN=

# ── Cron / Opt-out ─────────────────────────────────────
# Secret partagé pour /api/sequences/run (Vercel Cron envoie ?secret=)
CRON_SECRET=
# HMAC pour les liens d'unsubscribe one-click
OPTOUT_SECRET=
# URL publique de l'app (utilisée dans les liens d'opt-out)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Limite quotidienne d'actions LinkedIn par compte (défaut 80)
UNIPILE_DAILY_LIMIT=80

# ── IA (Phase 3) ───────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Embeddings 384-d pour look-alike (Jina, plan gratuit < 1M tokens/mois)
JINA_API_KEY=

# ── Observabilité ──────────────────────────────────────
SENTRY_DSN=
