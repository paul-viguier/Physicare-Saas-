# ============================================================================
# PHYSICARE® — variables d'environnement
# ----------------------------------------------------------------------------
# Copier ce fichier en `.env.local` et remplir les valeurs ci-dessous.
# `.env.local` est ignoré par git (cf. .gitignore) — n'y mettez jamais
# de clé service_role en clair.
# ============================================================================

# ----- Supabase ---------------------------------------------------------------
# Trouvable dans Supabase Studio → Project Settings → API
#   - URL : "Project URL"
#   - KEY : "anon / public key" (PAS la service_role !)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.VOTRE_ANON_KEY

# ----- (optionnel) Service role pour scripts admin / seeds --------------------
# Ne JAMAIS exposer dans le navigateur — utile uniquement côté serveur ou CLI
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.VOTRE_SERVICE_KEY

# ----- (optionnel) Mot de passe back-office ----------------------------------
# Défaut historique : physicare2026
# BACKOFFICE_PASSWORD=physicare2026
